# Общий .editorconfig стандарта: setup кладёт копию в корень проекта и сверяет её.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

# В Markdown пробелы в конце строки значимы, а в шаблонах задач есть заготовки вида «1. ».
[*.md]
trim_trailing_whitespace = false
